{
    "name":  "jiashuge",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview --host",
                    "typecheck":  "vue-tsc --noEmit",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "e2e":  "npm run build && playwright test",
                    "test:all":  "npm run typecheck && npm run test && npm run e2e",
                    "e2e:fast":  "playwright test",
                    "e2e:install":  "playwright install --with-deps chromium"
                },
    "dependencies":  {
                         "pinia":  "^2.1.7",
                         "vue":  "^3.4.21",
                         "vue-router":  "^4.3.0"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.60.0",
                            "@types/node":  "^25.9.3",
                            "@vitejs/plugin-vue":  "^5.0.4",
                            "@vue/test-utils":  "^2.4.11",
                            "@vue/tsconfig":  "^0.5.1",
                            "autoprefixer":  "^10.4.18",
                            "jsdom":  "^29.1.1",
                            "postcss":  "^8.4.35",
                            "tailwindcss":  "^3.4.1",
                            "typescript":  "~5.4.0",
                            "vite":  "^5.2.0",
                            "vite-plugin-pwa":  "^1.3.0",
                            "vitest":  "^4.1.8",
                            "vue-tsc":  "^2.0.6"
                        }
}